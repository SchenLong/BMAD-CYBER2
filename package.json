{
  "name": "bmad-cyber2-framework",
  "version": "2.0.0",
  "description": "Production-ready BMAD security and automation framework with comprehensive validation, authentication, and audit capabilities",
  "type": "module",
  "main": "./framework/dist/index.js",
  "module": "./framework/dist/index.js",
  "types": "./framework/dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./framework/dist/index.js",
      "types": "./framework/dist/index.d.ts"
    },
    "./framework": {
      "import": "./framework/dist/index.js",
      "types": "./framework/dist/index.d.ts"
    },
    "./validators": {
      "import": "./framework/dist/validators/index.js",
      "types": "./framework/dist/validators/index.d.ts"
    },
    "./auth": {
      "import": "./framework/dist/auth/index.js",
      "types": "./framework/dist/auth/index.d.ts"
    },
    "./audit": {
      "import": "./framework/dist/audit/index.js",
      "types": "./framework/dist/audit/index.d.ts"
    }
  },
  "workspaces": [
    "framework",
    ".claude/validators-node"
  ],
  "scripts": {
    "build": "npm run build:framework && npm run build:validators",
    "build:framework": "cd framework && npm run build",
    "build:validators": "cd .claude/validators-node && npm run build",
    "build:watch": "npm run build:framework -- --watch",
    "dev": "npm run build:watch",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:performance": "vitest run --config vitest.config.performance.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && cd framework && tsc --noEmit && cd ../.claude/validators-node && tsc --noEmit",
    "security:scan": "npm audit --audit-level=moderate",
    "security:validate-framework": "node scripts/validate-security.js",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "validate:exports": "node scripts/validate-exports.js",
    "docs:generate": "typedoc --options typedoc.json",
    "docs:validate": "node scripts/validate-docs.js",
    "docs:check-readme": "node scripts/check-readme.js",
    "clean": "rm -rf dist framework/dist .claude/validators-node/dist",
    "prepack": "npm run clean && npm run build",
    "postinstall": "npm run build",
    "quality:check": "npm run lint && npm run type-check && npm run test:coverage",
    "ci:quality": "npm run quality:check && npm run security:scan && npm run build"
  },
  "keywords": [
    "bmad",
    "security",
    "framework",
    "typescript",
    "validation",
    "authentication",
    "rbac",
    "audit",
    "hooks",
    "enterprise",
    "production"
  ],
  "author": "Amelia (Dev) - BMAD Framework Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@bmad/validators": "file:.claude/validators-node",
    "commander": "^11.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "files": [
    "framework/dist/**/*",
    ".claude/validators-node/dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "framework/README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bmad/bmad-cyber2.git"
  },
  "bugs": {
    "url": "https://github.com/bmad/bmad-cyber2/issues"
  },
  "homepage": "https://github.com/bmad/bmad-cyber2#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}