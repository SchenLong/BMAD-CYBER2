{
  "name": "bmad-web-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 42001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_OPTIONS='--max-old-space-size=8192' jest",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=8192' jest --coverage",
    "test:security": "NODE_OPTIONS='--max-old-space-size=8192' jest --testPathPatterns=\"(security|cli-|auth-)\" --verbose",
    "test:integration": "NODE_OPTIONS='--max-old-space-size=8192' jest --testPathPatterns=integration --verbose",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=8192' jest --testIgnorePatterns=\"tests/e2e|tests/performance|src/lib/openapi\" --verbose",
    "test:owasp": "NODE_OPTIONS='--max-old-space-size=8192' jest --testPathPatterns=owasp --verbose",
    "test:suite": "npm run test:security && npm run test:integration",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=8192' jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:perf:smoke": "k6 run tests/performance/smoke-test.k6.js",
    "test:perf:load": "k6 run tests/performance/load-test.k6.js",
    "test:perf:staging": "BASE_URL=$(STAGING_URL) k6 run tests/performance/load-test.k6.js",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:audit && npm run test:security"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "execa": "^9.6.1",
    "immer": "^11.1.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "otplib": "^13.3.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^12.0.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
