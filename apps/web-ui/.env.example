# BMAD Web UI Environment Variables
# Copy this file to .env.local and fill in the required values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# The URL where this application is running
NEXT_PUBLIC_APP_URL=http://localhost:42001

# The URL of the API backend (if using separate backend)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# =============================================================================
# CLI BRIDGE CONFIGURATION
# =============================================================================

# CLI Bridge Server URL (if using separate CLI bridge service)
# CLI_BRIDGE_URL=http://localhost:4000

# Path to BMAD CLI executable (for local development)
# BMAD_CLI_PATH=/usr/local/bin/bmad

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Database Connection String (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT Secret for session management (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Session Secret for cookie signing
SESSION_SECRET=your-super-secret-session-key-here

# =============================================================================
# SESSION MANAGEMENT CONFIGURATION (Story 1.6)
# =============================================================================

# Session expiry in minutes (default: 15)
SESSION_EXPIRY_MINUTES=15

# Refresh token expiry in days (default: 7)
REFRESH_TOKEN_EXPIRY_DAYS=7

# Maximum concurrent sessions per user (default: 5)
MAX_SESSIONS_PER_USER=5

# Cookie Secret for refresh token signing
COOKIE_SECRET=your-cookie-secret-key-here

# Cookie Security Settings (production)
# Set to true in production for HTTPS-only cookies
COOKIE_SECURE=true
# SameSite setting: 'strict', 'lax', or 'none'
COOKIE_SAMESITE=strict

# =============================================================================
# OAUTH PROVIDER CONFIGURATION (Story 1.3)
# =============================================================================

# Auth.js Secret (generate with: openssl rand -base64 33)
AUTH_SECRET=your-super-secret-auth-key-here

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# GitHub OAuth Credentials
# Get from: https://github.com/settings/developers
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Legacy OAuth Client IDs (for backwards compatibility)
# NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_OAUTH_GITHUB_CLIENT_ID=
# NEXT_PUBLIC_OAUTH_MICROSOFT_CLIENT_ID=

# =============================================================================
# LLM API CONFIGURATION
# =============================================================================

# Anthropic API Key (for Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (optional, for OpenAI models)
# OPENAI_API_KEY=sk-...

# LLM Provider (anthropic, openai, etc.)
# NEXT_PUBLIC_LLM_PROVIDER=anthropic

# =============================================================================
# DATABASE CONFIGURATION (Future Implementation)
# =============================================================================

# Database Connection String
# DATABASE_URL=postgresql://user:password@localhost:5432/bmad

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Allowed Origins (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:42001,https://your-domain.com

# Rate Limiting
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# MFA CONFIGURATION (Story 1.4)
# =============================================================================

# MFA Encryption Key (32 bytes hex encoded for AES-256-GCM)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# MFA Required for Enterprise Mode (true/false)
MFA_REQUIRED_FOR_ENTERPRISE=true

# App Name for TOTP QR Code
APP_NAME=BMAD

# Deployment Mode (enterprise/community)
# - enterprise: MFA is mandatory for all users
# - community: MFA is optional
DEPLOYMENT_MODE=community

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable experimental features
# NEXT_PUBLIC_ENABLE_TERMINAL=false
# NEXT_PUBLIC_ENABLE_WEBSOCKET=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Enable debug logging
# DEBUG=false

# Enable Sentry error tracking (optional)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# =============================================================================
# NOTES
# =============================================================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - All other variables are server-side only
# - Never commit .env.local files to version control
# - Use strong, randomly generated values for secrets in production
