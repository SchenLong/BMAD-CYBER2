# ============================================================================
# BMAD Validators Environment Configuration
# ============================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit .env files with actual values to version control.
# ============================================================================

# === SECURITY MODE ===
# strict  - Block on verification failure (RECOMMENDED for production)
# warn    - Log warning but allow (development only)
# disabled - No verification (NEVER use in production)
BMAD_VERIFY_MODE=strict

# === TOKEN AUTHENTICATION ===
# true  - Require valid session token (RECOMMENDED for production)
# false - Skip validation, creates audit entry (development only)
BMAD_TOKEN_REQUIRED=true

# === RESOURCE LIMITS ===
BMAD_MAX_MEMORY_MB=4096
BMAD_MAX_CPU_PERCENT=80
BMAD_MAX_CHILD_PROCS=10
BMAD_PROC_TIMEOUT=300
BMAD_MAX_FILE_SIZE_MB=50

# === TELEMETRY ===
BMAD_TELEMETRY_ENABLED=true
# BMAD_TELEMETRY_DIR=/custom/path/to/telemetry
BMAD_TELEMETRY_ROTATE_MB=50

# === SUPPLY CHAIN VERIFICATION ===
# GPG key ID for manifest signing
# BMAD_SIGNING_KEY=your-gpg-key-id
