# BMAD Framework .gitignore
# Generated for public GitHub release

# ===================
# Output Directories
# ===================
# User-generated outputs - these are created during workflow execution
_output/
_bmad-output/
_bmad-output/project-registry.yaml

# Security review documentation (internal development artifacts)
_bmad-output/BMAD-Security-Review/

# ===================
# Private Projects
# ===================
# Internal security investigations and private project documentation
docs/projects/

# Private project documentation
privateproject/

# ===================
# Claude Code Settings
# ===================
# Local settings contain user-specific configurations
.claude/settings.local.json
.claude/settings-python-backup.json
.claude/audio/
.claude/projects/

# ===================
# Archive Directories
# ===================
# Archived Python validators (development artifacts)
.claude/validators-python-backup/
# Legacy output artifacts
_bmad-output/
docs/archive/

# ===================
# Runtime State Files
# ===================
# Sensitive runtime state and configuration
.claude/.rate_limit_state.json
.claude/.confidence_state.json
.claude/.override_state.json
.claude/.resource_state.json
.claude/.session_claims.json
.claude/.session_validated
.claude/*.lock
.claude/dashboard.html

# ===================
# Planning Artifacts
# ===================
# Workflow planning documents (development artifacts)
**/workflow-plan-*.md
**/COMPLETE-*.md
**/VERIFICATION-REPORT.md
**/PRODUCTION-READY.md
**/MODULE-CREATION-PLAYBOOK.md
**/TROUBLESHOOTING-GUIDE.md

# ===================
# OS Generated Files
# ===================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================
# Editor/IDE Files
# ===================
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ===================
# Logs and Temp Files
# ===================
*.log
*.tmp
*.temp
.cache/

# ===================
# Environment Files
# ===================
.env
.env.local
.env.*.local
*.env

# ===================
# Security Keys
# ===================
# Private signing key - NEVER commit
_bmad/core/security/bmad-private-key.asc
.bmad-token
.bmad-key

# ===================
# Node.js (if applicable)
# ===================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===================
# Python (if applicable)
# ===================
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
docs/ValidationLog/agent-validation-2026-01-13.md
docs/ValidationLog/documentation-validation-2026-01-13.md
docs/ValidationLog/full-validation-plan-2026-01-13.md
docs/ValidationLog/workflow-validation-2026-01-13.md
