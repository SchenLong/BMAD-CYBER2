{
  "name": "@bmad-cybercommand/root",
  "version": "2.0.0",
  "description": "BMAD Specialized Teams - Multi-Module Distribution Package",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "BMAD Development Team",
    "email": "dev@bmad.ai",
    "url": "https://bmad.ai"
  },
  "homepage": "https://github.com/bmad-code-org/bmad-specialized-teams#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmad-code-org/bmad-specialized-teams.git"
  },
  "bugs": {
    "url": "https://github.com/bmad-code-org/bmad-specialized-teams/issues"
  },
  "keywords": [
    "bmad",
    "agent",
    "workflow",
    "cybersecurity",
    "intelligence",
    "legal",
    "strategy",
    "multi-module"
  ],
  "workspaces": [
    "src/cybersec-team",
    "src/intel-team",
    "src/legal-team",
    "src/strategy-team"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cybersec-team": {
      "import": "./dist/cybersec-team/index.js",
      "require": "./dist/cybersec-team/index.cjs"
    },
    "./intel-team": {
      "import": "./dist/intel-team/index.js",
      "require": "./dist/intel-team/index.cjs"
    },
    "./legal-team": {
      "import": "./dist/legal-team/index.js",
      "require": "./dist/legal-team/index.cjs"
    },
    "./strategy-team": {
      "import": "./dist/strategy-team/index.js",
      "require": "./dist/strategy-team/index.cjs"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:modules && npm run build:dist",
    "build:modules": "npm run build --workspaces",
    "build:dist": "rollup -c rollup.config.js",
    "clean": "rimraf dist/ && npm run clean --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "vitest run tests/integration/",
    "validate": "npm run validate --workspaces",
    "validate:agents": "bmad validate agents --all-modules",
    "validate:workflows": "bmad validate workflows --all-modules",
    "validate:dependencies": "bmad validate dependencies --cross-module",
    "convert": "npm run convert --workspaces",
    "convert:agents": "bmad convert agents --format yaml --all-modules",
    "convert:workflows": "bmad convert workflows --format yaml --all-modules",
    "package": "npm run package --workspaces",
    "publish:modules": "npm run publish --workspaces",
    "prepublishOnly": "npm run build && npm run test && npm run validate",
    "dev": "npm run dev --workspaces",
    "docs": "typedoc --options typedoc.json",
    "lint": "eslint src/ --ext .js,.ts,.yaml,.yml",
    "format": "prettier --write src/ *.md *.json",
    "security-audit": "npm audit --audit-level moderate",
    "deps:update": "npm update && npm update --workspaces",
    "deps:check": "npm outdated && npm outdated --workspaces"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-yaml": "^0.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@bmad/core": "^2.0.0",
    "yaml": "^2.3.0",
    "ajv": "^8.12.0",
    "semver": "^7.5.0"
  },
  "peerDependencies": {
    "@bmad/cli": "^2.0.0"
  },
  "bmadModules": {
    "cybersec-team": {
      "path": "src/cybersec-team",
      "agents": 15,
      "workflows": 13,
      "dependencies": ["@bmad/core"]
    },
    "intel-team": {
      "path": "src/intel-team",
      "agents": 11,
      "workflows": 19,
      "dependencies": ["@bmad/core"]
    },
    "legal-team": {
      "path": "src/legal-team",
      "agents": 13,
      "workflows": 8,
      "dependencies": ["@bmad/core"]
    },
    "strategy-team": {
      "path": "src/strategy-team",
      "agents": 14,
      "workflows": 16,
      "dependencies": ["@bmad/core"]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}