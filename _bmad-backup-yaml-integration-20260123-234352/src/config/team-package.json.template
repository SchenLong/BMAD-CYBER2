{
  "name": "@bmad-cybercommand/{TEAM_MODULE_CODE}",
  "version": "2.0.0",
  "description": "{TEAM_DESCRIPTION}",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "BMAD Development Team",
    "email": "dev@bmad.ai",
    "url": "https://bmad.ai"
  },
  "homepage": "https://github.com/bmad-code-org/bmad-specialized-teams/tree/main/src/{TEAM_MODULE_CODE}#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmad-code-org/bmad-specialized-teams.git",
    "directory": "src/{TEAM_MODULE_CODE}"
  },
  "bugs": {
    "url": "https://github.com/bmad-code-org/bmad-specialized-teams/issues"
  },
  "keywords": [
    "bmad",
    "agent",
    "workflow",
    "{TEAM_KEYWORD_1}",
    "{TEAM_KEYWORD_2}",
    "{TEAM_KEYWORD_3}"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agents": {
      "import": "./dist/agents/index.mjs",
      "require": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./workflows": {
      "import": "./dist/workflows/index.mjs",
      "require": "./dist/workflows/index.js",
      "types": "./dist/workflows/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.mjs",
      "require": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "agents/",
    "workflows/",
    "tools/",
    "data/",
    "README.md",
    "CHANGELOG.md",
    "module.yaml"
  ],
  "scripts": {
    "build": "npm run clean && npm run convert && npm run compile && npm run package",
    "clean": "rimraf dist/",
    "convert": "npm run convert:agents && npm run convert:workflows",
    "convert:agents": "bmad convert agents --format yaml --input agents/ --output dist/agents/",
    "convert:workflows": "bmad convert workflows --format yaml --input workflows/ --output dist/workflows/",
    "compile": "tsc && rollup -c",
    "package": "bmad package --module {TEAM_MODULE_CODE} --output dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agents": "bmad test agents --module {TEAM_MODULE_CODE}",
    "test:workflows": "bmad test workflows --module {TEAM_MODULE_CODE}",
    "validate": "npm run validate:agents && npm run validate:workflows && npm run validate:dependencies",
    "validate:agents": "bmad validate agents --module {TEAM_MODULE_CODE}",
    "validate:workflows": "bmad validate workflows --module {TEAM_MODULE_CODE}",
    "validate:dependencies": "bmad validate dependencies --module {TEAM_MODULE_CODE}",
    "dev": "bmad dev --module {TEAM_MODULE_CODE}",
    "prepublishOnly": "npm run build && npm run test && npm run validate",
    "lint": "eslint . --ext .js,.ts,.yaml,.yml",
    "format": "prettier --write . --ignore-path .gitignore"
  },
  "devDependencies": {
    "@bmad/build-tools": "^2.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@bmad/core": "^2.0.0",
    "yaml": "^2.3.0",
    "ajv": "^8.12.0"
  },
  "peerDependencies": {
    "@bmad/cli": "^2.0.0",
    "@bmad-cybercommand/cybersec-team": "^2.0.0",
    "@bmad-cybercommand/intel-team": "^2.0.0",
    "@bmad-cybercommand/legal-team": "^2.0.0",
    "@bmad-cybercommand/strategy-team": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@bmad-cybercommand/cybersec-team": {
      "optional": true
    },
    "@bmad-cybercommand/intel-team": {
      "optional": true
    },
    "@bmad-cybercommand/legal-team": {
      "optional": true
    },
    "@bmad-cybercommand/strategy-team": {
      "optional": true
    }
  },
  "bmad": {
    "module": {
      "code": "{TEAM_MODULE_CODE}",
      "type": "specialized-team",
      "version": "2.0.0"
    },
    "capabilities": {
      "agents": {AGENT_COUNT},
      "workflows": {WORKFLOW_COUNT},
      "cross_team_integration": true,
      "multi_module_compatible": true
    },
    "paths": {
      "agents": "agents/",
      "workflows": "workflows/",
      "tools": "tools/",
      "data": "data/",
      "config": "module.yaml"
    },
    "conversion": {
      "agents": {
        "input_format": "markdown",
        "output_format": "yaml",
        "schema_version": "1.0"
      },
      "workflows": {
        "input_format": "markdown",
        "output_format": "yaml",
        "schema_version": "1.0"
      }
    },
    "integration": {
      "cross_team_workflows": {CROSS_TEAM_WORKFLOWS},
      "shared_dependencies": {SHARED_DEPENDENCIES},
      "security_model": "{SECURITY_MODEL}"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}